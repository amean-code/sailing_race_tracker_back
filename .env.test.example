# Isolated local/test backend — do NOT point this at production.
# Usage:
#   1) docker compose up -d   # Postgres on localhost:5433
#   2) cp .env.test.example .env.local
#   3) export $(grep -v '^#' .env.local | xargs)   # or start Nest with dotenv of .env.local
#   4) npm run migration:run && npm run seed
#   5) npm run start:dev
#
# Frontend: set VITE_API_URL=http://localhost:5175 in sailing_race_tracker_front/.env.local

# Uses docker-compose Postgres on 5433 (isolated from local :5432 / production).
DATABASE_URL=postgresql://themis:themis_secret@localhost:5433/themis_race_tracker
JWT_SECRET=local-test-only-change-me
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=5175
APP_NAME=Themis Race Tracker API (Local Test)
